    <script>
        // Inicializa ícones
        lucide.createIcons();

        // ------------------
        // ESTADO DA APLICAÇÃO
        // ------------------
        let isOffline = false;
        let cart = [];
        const TAX_RATE = 0.10; // 10% simulando o Motor de Impostos

        // Mock de Produtos Físicos e Serviços (Ficha Técnica implícita)
        const products = [
            { id: 1, name: 'Corte de Cabelo', type: 'service', price: 45.00, img: 'scissors', color: 'bg-purple-100 text-purple-600', stock: null },
            { id: 2, name: 'Pintura (Serviço)', type: 'service', price: 120.00, img: 'paint-bucket', color: 'bg-pink-100 text-pink-600', stock: null, insumo: 'Tinta (1/2 lata)' },
            { id: 3, name: 'Pomada Modeladora', type: 'product', price: 35.00, img: 'box', color: 'bg-blue-100 text-blue-600', stock: 12 },
            { id: 4, name: 'Shampoo Premium', type: 'product', price: 55.00, img: 'droplet', color: 'bg-cyan-100 text-cyan-600', stock: 2 }, // Estoque baixo
            { id: 5, name: "Tinta L'Oréal", type: 'product', price: 40.00, img: 'palette', color: 'bg-orange-100 text-orange-600', stock: 5 },
            { id: 6, name: 'Barba Terapia', type: 'service', price: 30.00, img: 'smile', color: 'bg-indigo-100 text-indigo-600', stock: null }
        ];

        // ------------------
        // RENDERIZAÇÃO DO PDV
        // ------------------
        function renderProducts() {
            const grid = document.getElementById('products-grid');
            grid.innerHTML = '';
            
            products.forEach(p => {
                const isLowStock = p.type === 'product' && p.stock <= 3;
                
                const card = document.createElement('div');
                card.className = `bg-white rounded-xl p-4 shadow-sm border border-gray-100 cursor-pointer hover:shadow-md hover:border-primary transition-all group relative`;
                card.onclick = () => addToCart(p);
                
                card.innerHTML = `
                    ${isLowStock ? `<span class="absolute top-2 right-2 flex h-3 w-3"><span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75"></span><span class="relative inline-flex rounded-full h-3 w-3 bg-red-500"></span></span>` : ''}
                    <div class="w-12 h-12 rounded-lg ${p.color} flex items-center justify-center mb-3 group-hover:scale-110 transition-transform">
                        <i data-lucide="${p.img}"></i>
                    </div>
                    <div class="flex flex-col">
                        <span class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-1">${p.type === 'service' ? 'Serviço' : 'Produto'}</span>
                        <span class="font-bold text-gray-800 leading-tight mb-2">${p.name}</span>
                        <span class="text-primary font-bold">R$ ${p.price.toFixed(2).replace('.', ',')}</span>
                    </div>
                `;
                grid.appendChild(card);
            });
            lucide.createIcons(); // re-init icons for dynamic content
        }

        function addToCart(product) {
            const existing = cart.find(item => item.id === product.id);
            if (existing) {
                existing.qty++;
            } else {
                cart.push({ ...product, qty: 1 });
            }
            updateCartUI();
            
            // Simula aviso de insumo
            if(product.insumo) {
                showToast(`Serviço adicionado. Insumo descontará: ${product.insumo}`, 'info', 'blue');
            }
        }

        function removeFromCart(id) {
            cart = cart.filter(item => item.id !== id);
            updateCartUI();
        }

        function clearCart() {
            cart = [];
            updateCartUI();
        }

        function updateCartUI() {
            const container = document.getElementById('cart-items');
            const subtotalEl = document.getElementById('cart-subtotal');
            const taxEl = document.getElementById('cart-tax');
            const totalEl = document.getElementById('cart-total');
            const btnCheckout = document.getElementById('btn-checkout');

            if (cart.length === 0) {
                container.innerHTML = `
                    <div class="h-full flex flex-col items-center justify-center text-gray-400 gap-3">
                        <i data-lucide="package-open" class="w-12 h-12 text-gray-300"></i>
                        <p>Adicione itens para iniciar a venda</p>
                    </div>`;
                subtotalEl.innerText = 'R$ 0,00';
                taxEl.innerText = 'R$ 0,00';
                totalEl.innerText = 'R$ 0,00';
                btnCheckout.innerText = 'Cobrar R$ 0,00';
                btnCheckout.disabled = true;
                lucide.createIcons();
                return;
            }

            container.innerHTML = '';
            let subtotal = 0;

            cart.forEach(item => {
                const itemTotal = item.price * item.qty;
                subtotal += itemTotal;
                
                container.innerHTML += `
                    <div class="flex justify-between items-center bg-white p-3 rounded-lg border border-gray-100 mb-2 shadow-sm fade-in">
                        <div class="flex-1">
                            <p class="font-bold text-gray-800 text-sm truncate">${item.name}</p>
                            <p class="text-xs text-gray-500">${item.qty}x R$ ${item.price.toFixed(2).replace('.', ',')}</p>
                        </div>
                        <div class="flex items-center gap-3">
                            <span class="font-bold text-gray-800">R$ ${itemTotal.toFixed(2).replace('.', ',')}</span>
                            <button onclick="removeFromCart(${item.id})" class="text-red-400 hover:text-red-600 bg-red-50 p-1 rounded">
                                <i data-lucide="trash-2" class="w-4 h-4"></i>
                            </button>
                        </div>
                    </div>
                `;
            });

            const tax = subtotal * TAX_RATE;
            const total = subtotal + tax;

            subtotalEl.innerText = `R$ ${subtotal.toFixed(2).replace('.', ',')}`;
            taxEl.innerText = `R$ ${tax.toFixed(2).replace('.', ',')}`;
            totalEl.innerText = `R$ ${total.toFixed(2).replace('.', ',')}`;
            btnCheckout.innerHTML = `<i data-lucide="credit-card" class="w-5 h-5"></i> Cobrar R$ ${total.toFixed(2).replace('.', ',')}`;
            btnCheckout.disabled = false;
            
            lucide.createIcons();
            
            // Rola para baixo no carrinho
            container.scrollTop = container.scrollHeight;
        }

        function checkout() {
            if(isOffline) {
                showToast('Venda salva localmente! Sincronizará quando a internet voltar.', 'wifi-off', 'orange');
            } else {
                showToast('Venda finalizada com sucesso!', 'check-circle', 'green');
            }
            clearCart();
        }

        // ------------------
        // NAVEGAÇÃO E UI
        // ------------------
        function switchTab(tabId) {
            // Oculta todas
            document.getElementById('view-pdv').classList.add('hidden');
            document.getElementById('view-dashboard').classList.add('hidden');
            const viewEquipe = document.getElementById('view-equipe');
            if(viewEquipe) viewEquipe.classList.add('hidden');
            
            // Reseta cores dos botões
            document.querySelectorAll('nav button').forEach(btn => {
                btn.classList.remove('bg-primary', 'text-white');
                btn.classList.add('text-gray-300', 'hover:bg-gray-800');
            });

            // Ativa selecionada
            document.getElementById(`view-${tabId}`)?.classList.remove('hidden');
            document.getElementById(`nav-${tabId}`).classList.remove('text-gray-300', 'hover:bg-gray-800');
            document.getElementById(`nav-${tabId}`).classList.add('bg-primary', 'text-white');

            // Atualiza Título
            const titles = {
                'pdv': 'Frente de Caixa (PDV)',
                'dashboard': 'Visão Analítica do Negócio',
                'estoque': 'Gestão de Estoque (Em Breve)',
                'equipe': 'Gestão de Equipe & Acessos'
            };
            document.getElementById('page-title').innerText = titles[tabId] || 'GlobalPOS';

            // Renderiza gráficos se for dashboard
            if(tabId === 'dashboard' && !window.chartInitialized) {
                initChart();
                window.chartInitialized = true;
            }
            
            // Notificação temporária para abas não implementadas
            if(tabId === 'estoque') {
                showToast('Esta funcionalidade está sendo desenvolvida no protótipo.', 'hammer', 'blue');
            }
        }

        // --- FUNÇÕES DE AUTENTICAÇÃO MOCK ---
        function doLogin() {
            document.getElementById('view-login').classList.add('hidden');
            showToast('Bem-vindo de volta!', 'check-circle', 'green');
        }

        function registerOwner() {
            showToast('Solicitação enviada! O Administrador analisará sua conta.', 'clock', 'orange');
            // Mock de limpeza após enviar
            setTimeout(() => {
                document.getElementById('view-login').classList.add('hidden');
                showToast('Aviso: Como demonstração, você foi logado automaticamente.', 'info', 'blue');
            }, 3000);
        }

        function addEmployee() {
            showToast('Membro salvo com sucesso! (O sistema vinculou o Tenant ID automaticamente)', 'user-check', 'green');
        }

        function toggleConnection() {
            isOffline = !isOffline;
            const btn = document.getElementById('conn-status');
            const text = document.getElementById('conn-text');
            
            if (isOffline) {
                btn.className = "flex items-center gap-2 px-3 py-1.5 rounded-full bg-orange-100 text-orange-700 text-sm font-medium border border-orange-200 transition-colors";
                btn.innerHTML = `<i data-lucide="wifi-off" class="w-4 h-4"></i> <span id="conn-text">Modo Offline Local</span>`;
                showToast('Conexão perdida. O PDV continuará funcionando localmente.', 'wifi-off', 'orange');
            } else {
                btn.className = "flex items-center gap-2 px-3 py-1.5 rounded-full bg-green-100 text-green-700 text-sm font-medium border border-green-200 transition-colors";
                btn.innerHTML = `<span class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></span> <span id="conn-text">Online e Sincronizado</span>`;
                showToast('Conexão restabelecida. Sincronizando dados pendentes...', 'refresh-cw', 'green');
            }
            lucide.createIcons();
        }

        function showToast(msg, iconStr, color) {
            const toast = document.getElementById('toast');
            const icon = document.getElementById('toast-icon');
            
            document.getElementById('toast-message').innerText = msg;
            
            // Colors
            const colorMap = {
                'green': 'text-green-400',
                'blue': 'text-blue-400',
                'orange': 'text-orange-400',
                'red': 'text-red-400'
            };
            
            icon.className = `w-5 h-5 ${colorMap[color] || 'text-white'}`;
            icon.setAttribute('data-lucide', iconStr);
            lucide.createIcons();

            toast.classList.remove('translate-y-20', 'opacity-0');
            
            setTimeout(() => {
                toast.classList.add('translate-y-20', 'opacity-0');
            }, 3500);
        }

        // ------------------
        // GRÁFICO (Chart.js)
        // ------------------
        function initChart() {
            const ctx = document.getElementById('cashflowChart').getContext('2d');
            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: ['Semana 1', 'Semana 2', 'Semana 3', 'Semana 4'],
                    datasets: [
                        {
                            label: 'Entradas (Vendas)',
                            data: [4500, 5200, 4800, 6100],
                            backgroundColor: '#10B981', // Emerald
                            borderRadius: 4
                        },
                        {
                            label: 'Saídas (Credores/Contas)',
                            data: [-2100, -1800, -3200, -1500],
                            backgroundColor: '#EF4444', // Red
                            borderRadius: 4
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'bottom' }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: { color: '#f3f4f6' }
                        },
                        x: {
                            grid: { display: false }
                        }
                    }
                }
            });
        }

        // Inicialização
        window.onload = () => {
            renderProducts();
        };

    </script>
</body>
</html>